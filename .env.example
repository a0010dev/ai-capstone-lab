# Copy this file to .env and set your own key. Do not commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Experimental alternative runtime: manual or pydanticai.
REPORTING_AGENT_BACKEND=manual
OPENAI_JUDGE_MODEL=gpt-4o-mini

# Monitoring: write token for export; read token only for optional trace queries.
LOGFIRE_TOKEN=
LOGFIRE_READ_TOKEN=
